{
  "name": "dsh-ding",
  "version": "1.0.4",
  "description": "DSH 插件：对话完成时播放提示音 + Windows 通知，WebUI 铃铛按钮可调开关/音量/音效",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "notify.ps1",
    "toast-activate.ps1",
    "toast-activate.vbs",
    "cordis.patch.yml",
    "ds.ico",
    "ds-logo.svg",
    "ds-logo.png",
    "README.md",
    "LICENSE",
    "ding.mp3"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "notification",
    "windows",
    "toast",
    "dsh-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CAOGGL/dsh-ding.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
